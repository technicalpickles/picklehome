# .env.template: checked into repo, no real secrets here
# Run `just dotenv` to generate .env from 1Password (vault: picklehome)
# Add new secrets to this template AND to the picklehome vault, then re-run `just dotenv`
#
# !! DO NOT EDIT .env DIRECTLY, it is overwritten by `just dotenv`.
# !! Add new keys to .env.template, then run `just dotenv`.

# UniFi Network (1Password item: UniFi)
UNIFI_API_KEY={{ op://picklehome/UniFi/api_key }}
UNIFI_ADMIN_USERNAME={{ op://picklehome/UniFi/username }}
UNIFI_ADMIN_PASSWORD={{ op://picklehome/UniFi/credential }}
# Watched WiFi devices for roaming checks (comma or newline separated names)
UNIFI_WATCHED_DEVICES={{ op://picklehome/UniFi/watched_devices }}

# Cloudflare (1Password item: Cloudflare Radar)
CLOUDFLARE_RADAR_API_TOKEN={{ op://picklehome/Cloudflare Radar/credential }}

# Home network config (1Password item: picklehome/Home)
HOME_ZIP_CODE={{ op://picklehome/Home/zip }}
HOME_LAT={{ op://picklehome/Home/latitude }}
HOME_LON={{ op://picklehome/Home/longitude }}

# Ambient Weather stations (comma-separated MACs, 1Password item: picklehome/Ambient Weather Stations)
AMBIENT_STATION_MACS={{ op://picklehome/Ambient Weather Stations/station_macs }}

# Named locations (main house, beachhouse, ...) shared by climate + locks.
# PICKLEHOME_LOCATIONS is NOT set here: `just dotenv` generates it by discovering
# every 1Password item tagged `picklehome-location`. Each such item needs fields:
#   slug, label, latitude, longitude, station_macs (comma-separated),
#   comfort_mode ("true" if this tooling manages its thermostat),
#   yale_houses (comma-separated Yale house names, for grouping locks by location)
# HOME_LAT/HOME_LON/AMBIENT_STATION_MACS above are the legacy single-home fallback
# used when no tagged items exist. See climate/README.md and scripts/locations-filter.jq.

# Ecobee thermostat API (1Password item: Ecobee)
ECOBEE_API_KEY={{ op://picklehome/Ecobee/api_key }}

# BlueAir purifier API (1Password item: BlueAir)
BLUEAIR_USERNAME={{ op://picklehome/BlueAir/username }}
BLUEAIR_PASSWORD={{ op://picklehome/BlueAir/password }}
BLUEAIR_REGION={{ op://picklehome/BlueAir/region }}

# Hisense ductless HVAC via ConnectLife (1Password item: ConnectLife)
CONNECTLIFE_USERNAME={{ op://picklehome/ConnectLife/username }}
CONNECTLIFE_PASSWORD={{ op://picklehome/ConnectLife/password }}

# Lutron Caseta (1Password item: Lutron Caseta)
LUTRON_BRIDGE_IP={{ op://picklehome/Lutron Caseta/bridge_ip }}
# Cert files are written to lighting/.certs/ by scripts/dotenv (see LUTRON_CERTS below)
LUTRON_KEYFILE=lighting/.certs/client.key
LUTRON_CERTFILE=lighting/.certs/client.crt
LUTRON_CAFILE=lighting/.certs/ca.crt

# Philips Hue (1Password item: Philips Hue)
HUE_BRIDGE_IP={{ op://picklehome/Philips Hue/bridge_ip }}
HUE_API_KEY={{ op://picklehome/Philips Hue/api_key }}

# Google Air Quality API (1Password item: Google Air Quality API)
# Enable at: https://console.cloud.google.com → APIs → Pollen API
GOOGLE_POLLEN_API_KEY={{ op://picklehome/Google Air Quality API/api_key }}

# Aladdin Connect garage door (1Password item: Aladdin Connect)
ALADDIN_EMAIL={{ op://picklehome/Aladdin Connect/email }}
ALADDIN_PASSWORD={{ op://picklehome/Aladdin Connect/password }}

# Yale Access locks (1Password item: Yale Access)
YALE_EMAIL={{ op://picklehome/Yale Access/username }}
YALE_PASSWORD={{ op://picklehome/Yale Access/credential }}

# Nest / Google Smart Device Management API
# OAuth client (1Password item: "picklehome nest", created in GCP project picklehome-homeassistant)
NEST_CLIENT_ID={{ op://picklehome/picklehome nest/client_id }}
NEST_CLIENT_SECRET={{ op://picklehome/picklehome nest/client_secret }}
# Device Access project (1Password item: "picklehome nest device access console")
NEST_PROJECT_ID={{ op://picklehome/picklehome nest device access console/project_id }}
# OAuth redirect URI registered on the client above; must match exactly (loopback flow)
NEST_REDIRECT_URI=http://localhost:13371

# Backup (restic)
RESTIC_REPOSITORY={{ op://picklehome/Restic Backup/repository }}
RESTIC_PASSWORD={{ op://picklehome/Restic Backup/password }}

# Brineworks PRM server (1Password item: Brineworks Server)
BRINEWORKS_DB_PASSWORD={{ op://picklehome/Brineworks Server/db_password }}
BRINEWORKS_API_KEY={{ op://picklehome/Brineworks Server/api_key }}

# Brineworks agent workspace deploy key (1Password item: Brineworks Agent, SSH key).
# Base64 of the ed25519 private key, single line so service-env's line filter keeps it.
# Stored as a custom field under the SSH-key item's "add more" section.
WORKSPACE_DEPLOY_KEY_B64={{ op://picklehome/Brineworks Agent/add more/workspace_deploy_key_b64 }}

# Brineworks agent cryptfile keyring master password (1Password item: Brineworks Agent Keyring).
# Unlocks the in-container Gmail token keyring at /data/keyring/cryptfile.cfg.
KEYRING_CRYPTFILE_PASSWORD={{ op://picklehome/Brineworks Agent Keyring/password }}

# Brineworks agent Tailscale node auth key (1Password item: Brineworks Agent).
# Reusable, tag:server; the ts-agent sidecar uses it to join the tailnet (used
# once, node identity then persists on /data/ts-state).
TS_AUTHKEY={{ op://picklehome/Brineworks Agent/add more/ts_authkey }}

# Second Brain Agent Tailscale node auth key (1Password item: Second Brain Agent).
# Separate key from brineworks-agent (lower blast radius per service).
# Reusable, tag:server; the ts-agent sidecar uses it to join the tailnet.
SECOND_BRAIN_AGENT_TS_AUTHKEY={{ op://picklehome/Second Brain Agent/ts_authkey }}

# TaskChampion sync server (1Password item: TaskChampion Sync)
# TASKCHAMPION_SYNC_HOST: Tailscale Services hostname (taskchampion.<tailnet>.ts.net)
TASKCHAMPION_SYNC_HOST={{ op://picklehome/TaskChampion Sync/host }}
# TASKCHAMPION_SYNC_SERVER_CLIENT_ID: server allowlist + client identifier (UUID).
# Encryption secret is intentionally NOT here; it never reaches picklelab.
TASKCHAMPION_SYNC_SERVER_CLIENT_ID={{ op://picklehome/TaskChampion Sync/client_id }}

# GitHub Actions self-hosted runner (1Password item: GitHub Actions Runner pirpg)
# Registration tokens expire ~1h after creation but only matter at first registration.
# To re-register: fetch a fresh token from
# https://github.com/technicalpickles/pirpg/settings/actions/runners/new
# (or via gh api -X POST repos/technicalpickles/pirpg/actions/runners/registration-token)
# and update the 1Password item's token field.
GITHUB_RUNNER_TOKEN={{ op://picklehome/GitHub Actions Runner pirpg/token }}
GITHUB_RUNNER_REPO_URL={{ op://picklehome/GitHub Actions Runner pirpg/repro_url }}

# Woodpecker CI (1Password item: Woodpecker CI, picklehome vault)
# OAuth App client/secret (NOT a GitHub App), shared agent gRPC secret, and the
# reusable tag:ci Tailscale auth key for the funnel sidecar. See
# docs/plans/2026-06-18-woodpecker-ci-design.md.
WOODPECKER_GITHUB_CLIENT={{ op://picklehome/Woodpecker CI/github_client }}
WOODPECKER_GITHUB_SECRET={{ op://picklehome/Woodpecker CI/github_secret }}
WOODPECKER_AGENT_SECRET={{ op://picklehome/Woodpecker CI/agent_secret }}
WOODPECKER_TS_AUTHKEY={{ op://picklehome/Woodpecker CI/ts_authkey }}

# OpenClaw (1Password item: OpenClaw, picklehome vault -- host/gateway_token/allowed_chat_ids/google_places_api_key
# only, picklelab-specific). Migrated from the pickleclaw spike -- ollama/openrouter/telegram
# values are referenced directly from pickleclaw's existing items, not copied.
# See docs/plans/2026-06-30-openclaw-deploy.md and homelab/services/openclaw/README.md.
OPENCLAW_HOST={{ op://picklehome/OpenClaw/host }}
OPENCLAW_GATEWAY_TOKEN={{ op://picklehome/OpenClaw/gateway_token }}
# READ BEFORE ADDING AN ID. This is a security control, not just an access list.
# It feeds channels.telegram.allowFrom AND commands.ownerAllowFrom (deploy.sh), and
# since 2026-07-26 it is also the ONLY thing scoping session reads: pickleclaw's
# openclaw-config/tools.json5 sets tools.sessions.visibility to "agent", so every
# session under agent id "main" can read, search, and send into every other one,
# regardless of which surface opened it (Telegram / CLI / Control UI / heartbeat).
# A second id here does not just add a chat. It grants that person history access to
# all of Josh's sessions and memory search across them. Groups are closed by default
# (deploy.sh never sets groupPolicy, so it resolves to "disabled") -- allowlisting a
# group would widen this the same way.
# Adding an id? Revisit that visibility line first. Background + the upstream bug it
# works around (openclaw/openclaw#114180): pickleclaw docs/setup-notes.md, section
# "Unrelated find: sessions_list and sessions_history disagree about tree".
OPENCLAW_ALLOWED_CHAT_IDS={{ op://picklehome/OpenClaw/allowed_chat_ids }}
# goplaces second-node experiment (docs/superpowers/plans/2026-07-07-goplaces-node-picklelab-deploy.md
# in the pickleclaw repo). Real key, never shared with the gateway's own placeholder value.
GOOGLE_PLACES_API_KEY={{ op://picklehome/OpenClaw/google_places_api_key }}
# gog-mcp's HTTP endpoint auth (1Password item: OpenClaw, picklehome vault). See
# docs/superpowers/specs/2026-08-26-gog-mcp-picklelab-rollout-design.md in the
# pickleclaw repo.
GOG_MCP_TOKEN={{ op://picklehome/OpenClaw/gog_mcp_token }}
# gog-mcp's file-keyring decryption password (1Password item: OpenClaw, picklehome vault).
# picklelab's keyring is a from-scratch grant (see the design spec's Credential
# provisioning section) -- generate a fresh random value, do not reuse the dev VM's.
GOG_KEYRING_PASSWORD={{ op://picklehome/OpenClaw/gog_keyring_password }}
OLLAMA_API_KEY={{ op://Brent Pickleclaw/fq45ph3greaikwivmta54w26wq/credential }}
OPENROUTER_API_KEY={{ op://Brent Pickleclaw/OpenRouter API Key - pickleclaw macbook/credential }}
TELEGRAM_BOT_TOKEN={{ op://Brent Pickleclaw/Brent Pickleclawbot Telegram/credential }}
# web_search (gemini provider) -- reused from pickleclaw, same key
GEMINI_API_KEY={{ op://Brent Pickleclaw/Brent Pickleclaw Gemini API Key/credential }}
# OPENCLAW_IMAGE (pinned image version, not a secret) moved to the private pickleclaw
# repo (openclaw-config/openclaw.env), symlinked in as openclaw.image.env the same way
# as openclaw.tools.json5/openclaw.mcp.json5 -- see README "Deploying Updates".

# OpenClaw workspace deploy key (1Password item: OpenClaw Workspace, SSH key).
# Base64 of the ed25519 private key, single line so service-env's line filter keeps it.
# Stored as a custom field under the SSH-key item's "add more" section.
OPENCLAW_WORKSPACE_DEPLOY_KEY_B64={{ op://picklehome/OpenClaw Workspace/workspace_deploy_key_b64 }}
# Fine-grained GitHub PAT, scoped to only technicalpickles/openclaw-workspace,
# Contents: Read and write. Used for the in-container workspace-git-sync cron job --
# the container has no ssh client (node:24-bookworm-slim), so git auth there is
# HTTPS + this token via a GIT_ASKPASS helper, not the SSH deploy key above.
# See docs/plans/2026-07-04-workspace-git-sync-picklelab-rollout.md.
OPENCLAW_WORKSPACE_GITHUB_TOKEN={{ op://picklehome/OpenClaw Workspace/github_pat }}
# Read-only deploy key for github.com/technicalpickles/pickleclaw (1Password item:
# OpenClaw Pickleclaw Deploy Key, SSH key). deploy.sh clones/pulls gog-mcp's source
# from it -- gog-mcp isn't open source like goplaces, so it can't be baked into this
# public repo's Dockerfile the way goplaces-node is. Base64, single line, same
# convention as OPENCLAW_WORKSPACE_DEPLOY_KEY_B64 above.
OPENCLAW_PICKLECLAW_DEPLOY_KEY_B64={{ op://picklehome/OpenClaw Pickleclaw Deploy Key/deploy_key_b64 }}

# Open WebUI (1Password item: Open WebUI, picklehome vault). Chat UI on picklelab
# backed by Ollama Cloud; reuses OLLAMA_API_KEY above. Single admin bootstrapped
# headlessly, signup disabled. See homelab/services/open-webui/README.md.
OPEN_WEBUI_HOST={{ op://picklehome/Open WebUI/host }}
OPEN_WEBUI_ADMIN_EMAIL={{ op://picklehome/Open WebUI/admin_email }}
OPEN_WEBUI_ADMIN_PASSWORD={{ op://picklehome/Open WebUI/admin_password }}
OPEN_WEBUI_SECRET_KEY={{ op://picklehome/Open WebUI/secret_key }}

# Open Terminal (1Password item: Open Terminal, picklehome vault). Sandboxed
# compute environment the Open WebUI chat AI drives via tool calls (shell,
# files, package installs). See homelab/services/open-webui/README.md
# "Open Terminal" section.
OPEN_TERMINAL_API_KEY={{ op://picklehome/Open Terminal/api_key }}

# VicoHome / Vico Nature (Harymor smart bird feeder), 1Password item: vicohome, Personal vault
VICOHOME_EMAIL={{ op://Personal/vicohome/username }}
VICOHOME_PASSWORD={{ op://Personal/vicohome/password }}

# LG ThinQ Connect (washer, dryer, refrigerator), 1Password item: LG ThinQ, picklehome vault.
# PAT is minted at https://connect-pat.lgthinq.com/tokens and lives in the `credential` field
# (the default for 1Password's API Credential type).
#
# LG_THINQ_CLIENT_ID is self-assigned, NOT issued by LG: nothing in the PAT flow gives you one and
# nothing on LG's end validates it. It is sent as the x-client-id header and used as the MQTT
# client id. Do not regenerate it. AWS IoT permits one live connection per client id and drops the
# older one when a second claims the same id.
#
# LG_THINQ_COUNTRY selects the API region (US -> aic -> api-aic.lgthinq.com).
LG_THINQ_PAT={{ op://picklehome/LG ThinQ/credential }}
LG_THINQ_CLIENT_ID={{ op://picklehome/LG ThinQ/client_id }}
LG_THINQ_COUNTRY={{ op://picklehome/LG ThinQ/country }}
