# .env.template — checked into repo, no real secrets here
# Run `just dotenv` to generate .env from 1Password (vault: picklehome)
# Add new secrets to this template AND to the picklehome vault, then re-run `just dotenv`
#
# !! DO NOT EDIT .env DIRECTLY — it is overwritten by `just dotenv`.
# !! Add new keys to .env.template, then run `just dotenv`.

# UniFi Network (1Password item: UniFi)
UNIFI_API_KEY={{ op://picklehome/UniFi/api_key }}
UNIFI_ADMIN_USERNAME={{ op://picklehome/UniFi/username }}
UNIFI_ADMIN_PASSWORD={{ op://picklehome/UniFi/credential }}

# Cloudflare (1Password item: Cloudflare Radar)
CLOUDFLARE_RADAR_API_TOKEN={{ op://picklehome/Cloudflare Radar/credential }}

# Home network config (1Password item: picklehome/Home)
HOME_ZIP_CODE={{ op://picklehome/Home/zip }}
HOME_LAT={{ op://picklehome/Home/latitude }}
HOME_LON={{ op://picklehome/Home/longitude }}

# Ambient Weather stations (comma-separated MACs — 1Password item: picklehome/Ambient Weather Stations)
AMBIENT_STATION_MACS={{ op://picklehome/Ambient Weather Stations/station_macs }}
