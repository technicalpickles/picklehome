# Python
__pycache__/
*.pyc
.venv/

# Credentials: never commit
.env
**/.env
**/.env.build
lighting/caseta-bridge.json
lighting/.certs/
# OpenClaw tool/MCP config would reveal internal server names/commands; kept in the
# private pickleclaw repo instead, symlinked in here for compose to find at deploy time
homelab/services/openclaw/openclaw.tools.json5
homelab/services/openclaw/openclaw.mcp.json5

# Sonos roster: uids embed device MACs (geolocatable via SonosNet); keep local
sonos/config/speakers.yaml

# Network diagnostic results contain public IPs, internal IPs, device names
network/diag-results/
network-diag-results/

# Claude Code local state: personal memory and machine-specific settings
.claude/projects/
.claude/settings.local.json
# BMAD skills are sourced from _bmad/; leave other local skills committable
.claude/skills/bmad-*/

# Vendor / reference repos
vendor/

# OS
.DS_Store
local-data/
tmp/

# Park skill session handoffs
.parkinglot/

# Git worktrees (per-branch checkouts under .worktrees/<branch>/)
.worktrees/

# Claude
/.claude/worktrees/
/.claude/settings.local.json
.superpowers/
