# Passwordless sudo for running bootstrap.sh on seapickle.
# Installed to /etc/sudoers.d/seapickle by setup-sudo.sh
#
# bootstrap.sh runs entirely as root (invoked via `sudo ./bootstrap.sh`), so
# this is the only rule needed -- everything the script does inherits root
# from this one elevation, no per-command sudo calls inside it to allowlist.

technicalpickles ALL=(ALL) NOPASSWD: /home/technicalpickles/seapickle/bootstrap.sh *
