#!/usr/bin/env bash
# Docker credential helper: hands the docker CLI a read:packages token for
# ghcr.io, resolved from 1Password at pull time, so nothing sits in
# ~/.docker/config.json. Installed as /usr/local/bin/docker-credential-picklehome-ghcr
# by setup-ghcr-pull-auth.sh and wired up with credHelpers in root's docker config.
#
# Only `get` does anything. `store` refuses so a stray `docker login` can't write
# the token to disk. Runs as whoever runs the docker CLI, and the service-account
# token file is 0600 root:root, so only root (the systemd units) can resolve it.
set -euo pipefail

TOKEN_FILE=${HOMELAB_OP_TOKEN_FILE:-/etc/opt/homelab/op-token-picklehome}
# 1Password item holding the classic PAT (read:packages only). Created by hand.
TOKEN_REF=${GHCR_PULL_OP_REF:-op://picklehome/GHCR Pull/credential}
USERNAME=${GHCR_PULL_USER:-technicalpickles}

case "${1:-}" in
    get)
        server=$(cat)
        if [ "$server" != "ghcr.io" ]; then
            echo "credentials not found in native keychain" >&2
            exit 1
        fi
        set -a
        # shellcheck disable=SC1090
        . "$TOKEN_FILE"
        set +a
        secret=$(op read --no-newline "$TOKEN_REF")
        printf '{"ServerURL":"ghcr.io","Username":"%s","Secret":"%s"}\n' "$USERNAME" "$secret"
        ;;
    store | erase)
        echo "picklehome-ghcr: credentials come from 1Password, nothing is stored" >&2
        exit 1
        ;;
    list)
        echo '{}'
        ;;
    *)
        echo "usage: docker-credential-picklehome-ghcr get|store|erase|list" >&2
        exit 2
        ;;
esac
