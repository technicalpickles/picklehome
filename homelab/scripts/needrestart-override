#!/usr/bin/perl
# Usage: needrestart-override <needrestart.conf> <unit>...
# Loads the config the way needrestart does and prints "<unit> <0|1|default>" per unit:
# 0 means needrestart never restarts it on its own.
use strict;
use warnings;

our %nrconf;
our $LOGPREF = '[needrestart-override]';
$nrconf{verbosity} = 0;

my $conf = shift or die "usage: needrestart-override <needrestart.conf> <unit>...\n";
-r $conf or die "cannot read $conf\n";
do $conf;
die "cannot load $conf: $@" if $@;

for my $unit (@ARGV) {
    my $value = 'default';
    for my $re (keys %{ $nrconf{override_rc} || {} }) {
        if ($unit =~ /$re/) {
            $value = $nrconf{override_rc}{$re};
            last;
        }
    }
    print "$unit $value\n";
}
