# Identity of picklelab, the production homelab host. Read by
# homelab/scripts/host-identity.sh (sourced by deploy.sh scripts). KEY=value
# lines only; quote values that contain a space.
HOMELAB_HOST_KIND=prod
# Appended to Tailscale Service names (svc:openclaw$SUFFIX). Empty on prod.
HOMELAB_SERVICE_SUFFIX=
# Name of a file under homelab/hosts/overlays/. Empty on prod.
HOMELAB_ENV_OVERLAY=
# 1Password vault holding the secrets that are not in the picklehome vault.
HOMELAB_SECONDARY_VAULT="Brent Pickleclaw"
BRINEWORKS_REF=main
PICKLECLAW_REF=main
# Other names this host answers to when a deploy is aimed at it (space separated).
HOMELAB_HOST_ALIASES="picklelab.tail2023b7.ts.net"
