# Env overlay for a dev host, selected by HOMELAB_ENV_OVERLAY=dev in the host's
# identity file. scripts/service-env prefers a line here over the same key in the
# repo root .env.template, so a dev host gets its own bot, chat ids and provider
# keys while every other secret resolves from the same prod references.
#
# Every value points into the picklehome-dev vault, the only vault besides
# picklehome that the dev service account can read. The last three keys replace
# the base template's entries from the Brent Pickleclaw vault, which that account
# cannot read; leaving one of them out would break op run on a dev host.
# tests/scripts/test_service_env.py pins that.
#
# Same format as .env.template: one KEY=value line per key, the value wrapped in
# double curly braces. op inject parses this whole file including comments, so
# comments describe references in words and never contain braces or the scheme.
# The item and field names must match what is created in 1Password by hand:
# a vault named picklehome-dev with items OpenClaw dev, Dev Telegram bot,
# Ollama dev key, OpenRouter dev key and Gemini dev key.
OPENCLAW_HOST={{ op://picklehome-dev/OpenClaw dev/host }}
OPENCLAW_WIDGETS_HOST={{ op://picklehome-dev/OpenClaw dev/widgets_host }}
OPENCLAW_GATEWAY_TOKEN={{ op://picklehome-dev/OpenClaw dev/gateway_token }}
OPENCLAW_ALLOWED_CHAT_IDS={{ op://picklehome-dev/OpenClaw dev/allowed_chat_ids }}
TELEGRAM_BOT_TOKEN={{ op://picklehome-dev/Dev Telegram bot/token }}
OLLAMA_API_KEY={{ op://picklehome-dev/Ollama dev key/credential }}
OPENROUTER_API_KEY={{ op://picklehome-dev/OpenRouter dev key/credential }}
GEMINI_API_KEY={{ op://picklehome-dev/Gemini dev key/credential }}
