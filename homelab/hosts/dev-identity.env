# Template for a dev host's identity file. devhost-new copies it to
# /etc/opt/homelab/host.env on the box; the host name comes from hostname -s
# unless HOMELAB_HOST_NAME is added below. Read by
# homelab/scripts/host-identity.sh. KEY=value lines only; quote values that
# contain a space.
HOMELAB_HOST_KIND=dev
# Appended to Tailscale Service names (svc:openclaw$SUFFIX).
HOMELAB_SERVICE_SUFFIX=-dev
# Name of a file under homelab/hosts/overlays/.
HOMELAB_ENV_OVERLAY=dev
# 1Password vault holding the secrets that are not in the picklehome vault.
HOMELAB_SECONDARY_VAULT=picklehome-dev
BRINEWORKS_REF=main
PICKLECLAW_REF=main
# Other names this host answers to when a deploy is aimed at it (space separated).
HOMELAB_HOST_ALIASES=
