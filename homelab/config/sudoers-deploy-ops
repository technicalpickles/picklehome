# Passwordless sudo for deploy operations on picklelab.
# Installed to /etc/sudoers.d/deploy-ops by homelab/scripts/setup-deploy-access.sh
#
# Scope: narrow allowlist covering commands used by deploy.sh scripts.
# See docs/plans/2026-04-09-deploy-sudoers.md for rationale.

# Directory setup
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/mkdir -p *

# Symlink systemd units into place
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/ln -sf *

# Pre-flight: verify the ci user's rootless docker socket (woodpecker deploy.sh).
# /run/user/2000 is mode 0700 owned by ci, so the unprivileged deploy user can't
# stat the socket; this lets the pre-check probe it from a root vantage. Read-only.
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/test -S /run/user/2000/docker.sock

# Systemd lifecycle
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/systemctl daemon-reload
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/systemctl enable *
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart *
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/systemctl start *
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop *
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/systemctl reset-failed *
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/systemctl status *
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/journalctl *

# Ownership changes (brineworks, backup)
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/chown *

# Permission changes (backup's op-config dir needs 700, op refuses anything broader)
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/chmod *

# Tailscale service advertising (brineworks)
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/tailscale serve *

# ACLs for backup cross-user reads
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/setfacl *

# Backup ACL re-apply script (deploy.sh runs it directly as root; the setfacl
# rule above doesn't match because sudo sees the script path, not `setfacl`)
technicalpickles ALL=(ALL) NOPASSWD: /opt/homelab/homelab/services/backup/reapply-acls.sh

# openclaw's deploy-time doctor/onboard/config-set/config-patch calls need to
# read the 0600 root:root op-token files to resolve real secrets (not just
# placeholders). run-doctor-cli.sh hardcodes everything but the trailing
# openclaw CLI args, so this grant can't be used to run an arbitrary command
# as root -- only the openclaw CLI, against openclaw's fixed compose project.
technicalpickles ALL=(ALL) NOPASSWD: /opt/homelab/homelab/services/openclaw/run-doctor-cli.sh *

# openclaw's resolve_picklehome_var() (deploy-key files, workspace git auth,
# config-set JSON payloads) needs the same root read of op-token-picklehome.
# read-picklehome-var.sh only ever prints one named var from openclaw's own
# vault-filtered template -- not an arbitrary command, not the raw token.
technicalpickles ALL=(ALL) NOPASSWD: /opt/homelab/homelab/services/openclaw/read-picklehome-var.sh *

# Backup user management (backup deploy)
technicalpickles ALL=(ALL) NOPASSWD: /usr/sbin/useradd *
technicalpickles ALL=(ALL) NOPASSWD: /usr/sbin/usermod *

# Package install (backup deploy installs restic, acl)
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/apt-get update
technicalpickles ALL=(ALL) NOPASSWD: /usr/bin/apt-get install *

# Run restic as backup user (backup deploy init/check). Runas is scoped to
# `backup` specifically, not ALL -- sudoers matches the resolved command
# (restic), not the `sudo -u backup` invocation syntax deploy.sh uses.
# SETENV is required because deploy.sh/backup-snapshots call this with `-E`
# to hand RESTIC_REPOSITORY/RESTIC_PASSWORD through -- global `env_reset`
# blocks env preservation on any NOPASSWD rule that doesn't opt in via
# SETENV, even though the rule matched. Confirmed live 2026-09-15: this was
# already broken (deploy.sh's restic-init check has been silently failing
# every deploy), not something the op-run migration introduced.
technicalpickles ALL=(backup) NOPASSWD: SETENV: /usr/bin/restic *

# backup's deploy-time restic-init check (and `just backup-snapshots`) need
# a root read of RESTIC_REPOSITORY/RESTIC_PASSWORD from op-token-picklehome,
# same reason and same narrow shape as openclaw's read-picklehome-var.sh
# above -- deploy.sh runs as the unprivileged deploy user and can't read the
# 0600 root:root token file itself.
technicalpickles ALL=(ALL) NOPASSWD: /opt/homelab/homelab/services/backup/read-picklehome-var.sh *
