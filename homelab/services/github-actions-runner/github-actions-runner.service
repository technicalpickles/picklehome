[Unit]
Description=GitHub Actions self-hosted runner (pirpg)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/homelab/homelab/services/github-actions-runner
ExecStart=/usr/bin/docker compose -f compose.yaml up -d --pull always
ExecStop=/usr/bin/docker compose -f compose.yaml down

[Install]
WantedBy=multi-user.target
