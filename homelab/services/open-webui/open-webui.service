[Unit]
Description=Open WebUI
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/homelab/homelab/services/open-webui
# open-webui draws secrets from both the picklehome and Brent Pickleclaw
# 1Password vaults (see .env.template / deploy.sh's "Writing filtered op-run
# templates" step), and op run only authenticates against one service-account
# token at a time -- so ExecStart/ExecStop go through op-run-dual.sh, which
# chains both `op run` calls (picklehome first, overriding
# OP_SERVICE_ACCOUNT_TOKEN for the inner pickleclaw call). This EnvironmentFile
# line still sets the picklehome token for the wrapper's own outer sourcing
# step, matching every other single-vault service's unit -- see
# op-run-dual.sh's own comments for why it re-sources it anyway (self-contained,
# callable outside systemd too).
EnvironmentFile=/etc/opt/homelab/op-token-picklehome
ExecStart=/opt/homelab/homelab/services/open-webui/op-run-dual.sh /opt/homelab/homelab/services/open-webui/.env.op.picklehome.template /opt/homelab/homelab/services/open-webui/.env.op.pickleclaw.template -- /usr/bin/docker compose -f compose.yaml -f compose.picklelab.yaml up -d --build
ExecStop=/opt/homelab/homelab/services/open-webui/op-run-dual.sh /opt/homelab/homelab/services/open-webui/.env.op.picklehome.template /opt/homelab/homelab/services/open-webui/.env.op.pickleclaw.template -- /usr/bin/docker compose -f compose.yaml -f compose.picklelab.yaml down

[Install]
WantedBy=multi-user.target
