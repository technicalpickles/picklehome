[Unit]
Description=Obsidian Sync headless (continuous vault sync)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/homelab/homelab/services/obsidian-sync
ExecStart=/usr/bin/docker compose -f compose.yaml -f compose.picklelab.yaml up -d
ExecStop=/usr/bin/docker compose -f compose.yaml -f compose.picklelab.yaml down

[Install]
WantedBy=multi-user.target
