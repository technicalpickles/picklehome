[Unit]
Description=Brineworks PRM server (FastAPI + Postgres)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/homelab/homelab/services/brineworks-server
EnvironmentFile=/etc/opt/homelab/op-token-picklehome
# .env.build is written by deploy.sh and carries deploy-time vars
# (BRINEWORKS_GIT_SHA, BRINEWORKS_SERVER_PORT) into the docker compose
# process env so compose's strict ${VAR:?...} interpolation succeeds.
EnvironmentFile=-/opt/homelab/homelab/services/brineworks-server/.env.build
ExecStart=/usr/bin/op run --env-file=/opt/homelab/homelab/services/brineworks-server/.env.op.template -- /usr/bin/docker compose --project-directory /opt/homelab/homelab/services/brineworks-server -f /opt/brineworks/server/compose.yaml -f compose.picklelab.yaml up -d --build
ExecStop=/usr/bin/op run --env-file=/opt/homelab/homelab/services/brineworks-server/.env.op.template -- /usr/bin/docker compose --project-directory /opt/homelab/homelab/services/brineworks-server -f /opt/brineworks/server/compose.yaml -f compose.picklelab.yaml down

[Install]
WantedBy=multi-user.target
