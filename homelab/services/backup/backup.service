[Unit]
Description=Restic backup of /srv/data (with database dumps)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=backup
Group=backup
# Restic cache lives alongside the repo so the backup user can write to it
# without needing a writable home directory.
Environment=RESTIC_CACHE_DIR=/srv/backups/restic-cache
# backup's User=backup has no writable home (/var/backups is root-owned, a
# stock Debian system account, not one this deploy created); `op` otherwise
# tries to create ~/.config/op and fails. OP_CACHE=false alone isn't enough
# -- op still wants a config dir regardless of caching -- so point it at a
# directory deploy.sh creates and chowns to backup:backup instead.
Environment=OP_CACHE=false
# Read by systemd itself (root) before it drops to User=backup below, so this
# works even though backup.sh never runs as root. See homelab/services/README.md.
EnvironmentFile=/etc/opt/homelab/op-token-picklehome
# The '+' runs this one line as root regardless of the unit's own User=/Group=,
# so it can re-apply ACLs that other services' chmod() calls may have wiped
# since the last run. See reapply-acls.sh for why this has to be unconditional.
ExecStartPre=+/opt/homelab/homelab/services/backup/reapply-acls.sh
ExecStart=/usr/bin/op --config /srv/backups/op-config run --env-file=/opt/homelab/homelab/services/backup/.env.op.template -- /opt/homelab/homelab/services/backup/backup.sh
