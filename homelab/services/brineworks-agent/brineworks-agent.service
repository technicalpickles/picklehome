[Unit]
Description=Brineworks mobile agent (SSH + tmux + Claude Code container)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/homelab/homelab/services/brineworks-agent
# Secrets reach the container via env_file (.env, written by deploy.sh); non-secret
# config is hardcoded in compose.yaml. The one ${VAR} the compose files interpolate
# is BRINEWORKS_SHA (the GIT_SHA build arg for image provenance) -- computed inline
# here from the /opt/brineworks tree being baked, so the status-bar sha matches the
# image. `|| echo unknown` keeps a fresh box (no /opt/brineworks yet) building clean.
ExecStart=/bin/sh -c 'BRINEWORKS_SHA=$(git -C /opt/brineworks rev-parse --short HEAD 2>/dev/null || echo unknown) /usr/bin/docker compose -f compose.yaml -f compose.picklelab.yaml up -d --build'
ExecStop=/usr/bin/docker compose -f compose.yaml -f compose.picklelab.yaml down

[Install]
WantedBy=multi-user.target
