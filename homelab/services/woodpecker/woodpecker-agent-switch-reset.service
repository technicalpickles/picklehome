[Unit]
Description=Woodpecker agent switch: restore defaults now (manual rollback, run by just woodpecker-switch-reset)
After=network-online.target docker.service woodpecker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
TimeoutStartSec=60
WorkingDirectory=/opt/homelab/homelab/services/woodpecker
EnvironmentFile=/etc/opt/homelab/op-token-picklehome
# WOODPECKER_API_TOKEN resolves via `op run` from .env.op.template (written by
# deploy.sh). --no-deps: the run joins the already-running ts-woodpecker netns and
# must not start or recreate any other part of the stack; if that sidecar is down
# the run fails, which is right because the API is down too.
ExecStart=/usr/bin/op run --env-file=/opt/homelab/homelab/services/woodpecker/.env.op.template -- /usr/bin/docker compose -f compose.yaml -f compose.picklelab.yaml --profile switch run --rm --no-deps woodpecker-agent-switch --reset
