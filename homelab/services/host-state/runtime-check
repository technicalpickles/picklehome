#!/usr/bin/env bash
# Exit 0 OK, 1 warning, 2 critical, 3 unknown.
set -euo pipefail

label="RUNTIME docker+containerd"
proc=${HOST_STATE_PROC:-/proc}
fix="restart both in a quiet window: sudo systemctl restart containerd docker"

val() { sed -n "s/^$1=//p" <<<"$2" | head -n1; }

read_unit() {
  local unit=$1 t
  t=$(systemctl show -p LoadState,ActiveState,MainPID,ActiveEnterTimestampMonotonic "$unit" 2>&1) || {
    echo "$label UNKNOWN - systemctl failed for $unit: ${t:0:120}"
    exit 3
  }
  if [[ $(val LoadState "$t") == not-found ]]; then
    echo "$label UNKNOWN - $unit not-found"
    exit 3
  fi
  if [[ $(val ActiveState "$t") != active ]]; then
    echo "$label CRITICAL - $unit is $(val ActiveState "$t")"
    exit 2
  fi
  local since pid
  since=$(val ActiveEnterTimestampMonotonic "$t")
  pid=$(val MainPID "$t")
  if [[ ! $since =~ ^[0-9]+$ || ! $pid =~ ^[0-9]+$ ]]; then
    echo "$label UNKNOWN - $unit has no start time or main pid"
    exit 3
  fi
  echo "$since $pid"
}

out=$(read_unit containerd.service) || { rc=$?; echo "$out"; exit "$rc"; }
read -r containerd_since containerd_pid <<<"$out"
out=$(read_unit docker.service) || { rc=$?; echo "$out"; exit "$rc"; }
read -r docker_since docker_pid <<<"$out"

# dockerd keeps container handles from the containerd it started against; after a
# containerd restart, exec, healthchecks and builds fail with "not found".
if (( containerd_since > docker_since )); then
  echo "$label CRITICAL - containerd restarted under a running dockerd, docker exec and healthchecks fail; $fix"
  exit 2
fi

stale=""
replaced() { grep -qE '\.so[.0-9]* \(deleted\)$' "$proc/$1/maps" 2>/dev/null; }
if replaced "$containerd_pid"; then stale+=" containerd"; fi
if replaced "$docker_pid"; then stale+=" dockerd"; fi
if [[ -n $stale ]]; then
  echo "$label WARNING -${stale} running replaced libraries; $fix"
  exit 1
fi
echo "$label OK - dockerd started after containerd, no replaced libraries"
