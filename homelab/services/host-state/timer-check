#!/usr/bin/env bash
# Usage: timer-check <name>.timer
# Exit 0 OK, 2 critical, 3 unknown. HOST_STATE_NOW (epoch seconds) overrides the clock.
set -euo pipefail

timer=${1:?usage: timer-check <name>.timer}
stuck_limit=3600
label="TIMER $timer"

val() { sed -n "s/^$1=//p" <<<"$2" | head -n1; }
fmt() { date -u -d "@$1" '+%F %H:%M UTC' 2>/dev/null || date -u -r "$1" '+%F %H:%M UTC'; }
unknown() { echo "$label UNKNOWN - $1"; exit 3; }
critical() { echo "$label CRITICAL - $1"; exit 2; }

t=$(systemctl show -p LoadState,ActiveState,NextElapseUSecRealtime,NextElapseUSecMonotonic,Unit \
  --timestamp=unix "$timer" 2>&1) || unknown "systemctl failed: ${t:0:120}"
[[ $(val LoadState "$t") != not-found ]] || unknown "not-found"

active=$(val ActiveState "$t")
[[ $active == active ]] || critical "timer is $active"

realtime=$(val NextElapseUSecRealtime "$t")
monotonic=$(val NextElapseUSecMonotonic "$t")
[[ -n $realtime || -n $monotonic ]] || critical "no next elapse scheduled"

service=$(val Unit "$t")
s=$(systemctl show -p ActiveState,Result,StateChangeTimestamp --timestamp=unix "$service" 2>&1) \
  || unknown "systemctl failed on $service: ${s:0:120}"

result=$(val Result "$s")
[[ $result == success ]] || critical "$service last result $result"

if [[ $(val ActiveState "$s") == activating ]]; then
  changed=$(val StateChangeTimestamp "$s")
  now=${HOST_STATE_NOW:-$(date +%s)}
  if [[ $changed == @* ]] && (( now - ${changed#@} >= stuck_limit )); then
    critical "$service stuck activating for $(( now - ${changed#@} ))s"
  fi
fi

if [[ $realtime == @* ]]; then
  echo "$label OK - next $(fmt "${realtime#@}")"
else
  echo "$label OK - next in $monotonic"
fi
