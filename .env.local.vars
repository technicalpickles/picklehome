# .env.local.vars: the keys `just dotenv` resolves into the local .env.
#
# .env.template is the one source for every secret, local and deployed. A deployed
# service reads only its own .env.vars on the host. The Mac reads only this list, so
# a deploy-only secret never lands in the laptop's .env, a recipe's environment, or a
# terminal status line. tests/scripts/test_dotenv_scope.py fails when local code reads
# a template key that is missing here.
#
# Adding a local module that reads a new template key? Add the key under its module.

# network
UNIFI_API_KEY
UNIFI_ADMIN_USERNAME
UNIFI_ADMIN_PASSWORD
UNIFI_WATCHED_DEVICES
CLOUDFLARE_RADAR_API_TOKEN
HOME_ZIP_CODE
TAILSCALE_OAUTH_CLIENT_ID
TAILSCALE_OAUTH_CLIENT_SECRET

# picklehome/locations.py (legacy single-home fallback)
HOME_LAT
HOME_LON
AMBIENT_STATION_MACS

# climate
ECOBEE_API_KEY
BLUEAIR_USERNAME
BLUEAIR_PASSWORD
BLUEAIR_REGION
CONNECTLIFE_USERNAME
CONNECTLIFE_PASSWORD
GOOGLE_POLLEN_API_KEY

# lighting
LUTRON_BRIDGE_IP
LUTRON_KEYFILE
LUTRON_CERTFILE
LUTRON_CAFILE
HUE_BRIDGE_IP
HUE_API_KEY

# garage, locks, nest, lg, water
ALADDIN_EMAIL
ALADDIN_PASSWORD
YALE_EMAIL
YALE_PASSWORD
NEST_CLIENT_ID
NEST_CLIENT_SECRET
NEST_PROJECT_ID
NEST_REDIRECT_URI
LG_THINQ_PAT
LG_THINQ_CLIENT_ID
LG_THINQ_COUNTRY
FLO_USERNAME
FLO_PASSWORD

# Justfile smoke checks (hostnames, not secrets)
OPENCLAW_HOST
OPEN_WEBUI_HOST
