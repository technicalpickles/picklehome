#!/usr/bin/env bash
# Prints the openclaw config writes deploy.sh makes, as one JSON array, without
# deploying. Takes only the top-level `config set` statements out of deploy.sh and
# runs them with RUN_CLI pointed at a stub that echoes its args, using dummy values.
set -euo pipefail

deploy="$(dirname "$0")/../homelab/services/openclaw/deploy.sh"

stub="$(mktemp)"
trap 'rm -f "$stub"' EXIT
cat > "$stub" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "${@: -1}"
STUB
chmod +x "$stub"

RUN_CLI="$stub"
OPENCLAW_HOST="${OPENCLAW_HOST:-openclaw.example.ts.net}"
ALLOW_FROM_JSON='["1"]'

snippet="$(awk '/^\$RUN_CLI config set/{p=1} p{print} /^\]'"'"'$/{p=0}' "$deploy")"
eval "$snippet" | jq -s '[.[][]] | sort_by(.path)'
