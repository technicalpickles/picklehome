#!/usr/bin/env bash
# Warn when the skills in the brineworks repo and the openclaw-workspace copies differ.
# Run by `just deploy-brineworks-server` after a healthy deploy (brineworks#34).
#
# Wraps brineworks' `scripts/sync-skills.sh --check`, which diffs
# <brineworks>/skills/<name>/ against <openclaw-workspace>/skills/<name>/. It fetches both
# repos and runs the check on their origin/main trees (exported to a temp dir), since a
# stale local checkout reports drift that isn't there. If a fetch fails it falls back to
# the local working trees and says so. Read-only: --check changes nothing, and fetch only
# updates remote-tracking refs.
#
# ALWAYS exits 0. Drift is expected between a deploy and the workspace PR (brineworks
# ADR 0013 and docs/runbooks/deploy.md: deploy first, then sync), and a missing
# checkout shouldn't fail a deploy that already succeeded. This only warns.
#
# Usage: scripts/brineworks-skills-check
# Env:   BRINEWORKS_DIR      brineworks checkout (default ~/github.com/technicalpickles/brineworks)
#        OPENCLAW_WORKSPACE  openclaw-workspace checkout, read by sync-skills.sh itself
#                            (its default is ~/github.com/technicalpickles/openclaw-workspace)
set -uo pipefail

BRINEWORKS_DIR="${BRINEWORKS_DIR:-$HOME/github.com/technicalpickles/brineworks}"
SYNC="$BRINEWORKS_DIR/scripts/sync-skills.sh"

echo "==> Checking openclaw-workspace skill copies for drift"

if [ ! -f "$SYNC" ]; then
    echo "    Skipping: no scripts/sync-skills.sh in $BRINEWORKS_DIR (set BRINEWORKS_DIR to a brineworks checkout)"
    exit 0
fi

ws="${OPENCLAW_WORKSPACE:-$HOME/github.com/technicalpickles/openclaw-workspace}"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
export_main() {
    local repo=$1 dest=$2; shift 2
    git -C "$repo" fetch -q origin main 2>/dev/null || return 1
    mkdir -p "$dest"
    git -C "$repo" archive origin/main "$@" | tar -x -C "$dest"
}
if export_main "$BRINEWORKS_DIR" "$tmp/brineworks" scripts/sync-skills.sh skills \
    && export_main "$ws" "$tmp/workspace" skills; then
    echo "    Comparing origin/main: brineworks@$(git -C "$BRINEWORKS_DIR" rev-parse --short origin/main), openclaw-workspace@$(git -C "$ws" rev-parse --short origin/main)"
    SYNC="$tmp/brineworks/scripts/sync-skills.sh"
    export OPENCLAW_WORKSPACE="$tmp/workspace"
else
    echo "    Fetch failed, comparing local working trees instead (they may be stale)"
fi

out=$(bash "$SYNC" --check 2>&1)
rc=$?
case "$rc" in
    0)
        echo "    Skills in sync"
        ;;
    1)
        echo "    WARNING: the openclaw-workspace skill copies are stale vs brineworks skills/"
        printf '%s\n' "$out" | grep -E ': (DRIFT|in sync)$' | sed 's/^/    /'
        echo "    Sync them: $BRINEWORKS_DIR/scripts/sync-skills.sh <name>, then commit and PR in openclaw-workspace."
        echo "    (Expected right after a deploy: this is step 2 of the update order in brineworks docs/runbooks/deploy.md.)"
        ;;
    2)
        echo "    Skipping: sync-skills.sh couldn't run its check:"
        printf '%s\n' "$out" | head -n 3 | sed 's/^/    /'
        ;;
    *)
        echo "    Skipping: sync-skills.sh exited $rc unexpectedly:"
        printf '%s\n' "$out" | head -n 3 | sed 's/^/    /'
        ;;
esac
exit 0
