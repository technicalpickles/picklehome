#!/usr/bin/env bash
# scripts/service-env: extract a subset of .env for a specific service
# Usage: scripts/service-env <path/to/.env.vars> [--env <path/to/.env>] [--template <path>] [--overlay <path>] [--strip-mustache]
#
# Reads the listed var names from .env.vars and outputs only those key=value
# pairs from .env (or the specified env file). Unrecognized vars in .env.vars
# are silently skipped (service may define its own defaults).
#
# Modes:
#   --env (default):      source is .env (resolved values)
#   --template <path>:    source is .env.template (op:// references, with mustache wrapper stripped)
#
# --overlay <path>: a second file in the same KEY=value format. For each wanted
# key, the overlay's line wins when it has one, else the base file's line is used.
# Mustache stripping under --template applies to both. A dev host uses this to
# swap a few secrets for its own while the rest resolve from the same base. An
# overlay key found in neither the base file nor the vars file is most likely a
# typo: it prints a warning on stderr and processing continues. A missing overlay
# file is an error (exit 1).
#
# Intended use: generate a minimal .env to copy to a remote host at deploy time,
# so each service only receives the secrets it actually needs.

set -euo pipefail

VARS_FILE=""
ENV_FILE=".env"
STRIP_MUSTACHE=0
OVERLAY_FILE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --env) ENV_FILE="$2"; shift 2 ;;
        --template) ENV_FILE="$2"; STRIP_MUSTACHE=1; shift 2 ;;
        --overlay) OVERLAY_FILE="$2"; shift 2 ;;
        -*) echo "Unknown argument: $1" >&2; exit 1 ;;
        *) VARS_FILE="$1"; shift ;;
    esac
done

if [[ -z "$VARS_FILE" ]]; then
    echo "Usage: scripts/service-env <path/to/.env.vars> [--env <path>] [--template <path>] [--overlay <path>]" >&2
    exit 1
fi

if [[ ! -f "$VARS_FILE" ]]; then
    echo "ERROR: vars file not found: $VARS_FILE" >&2
    exit 1
fi

if [[ ! -f "$ENV_FILE" ]]; then
    echo "ERROR: env file not found: $ENV_FILE" >&2
    exit 1
fi

if [[ -n "$OVERLAY_FILE" && ! -f "$OVERLAY_FILE" ]]; then
    echo "ERROR: overlay file not found: $OVERLAY_FILE" >&2
    exit 1
fi

# Read the list of wanted keys (skip blank lines and comments)
wanted=$(grep -v '^#' "$VARS_FILE" | grep -v '^[[:space:]]*$')

# An overlay key that neither the base file nor the vars file knows about is
# almost certainly a typo, and would otherwise be ignored without a trace.
if [[ -n "$OVERLAY_FILE" ]]; then
    while IFS= read -r okey; do
        if ! grep -qx -- "$okey" <<< "$wanted" && ! grep -q "^${okey}=" "$ENV_FILE"; then
            echo "WARNING: overlay key $okey is not in $ENV_FILE or $VARS_FILE" >&2
        fi
    done < <(grep -oE '^[A-Za-z0-9_]+=' "$OVERLAY_FILE" | sed 's/=$//' || true)
fi

# Extract matching lines in order; the overlay's line wins over the base's.
while IFS= read -r key; do
    match=""
    if [[ -n "$OVERLAY_FILE" ]]; then
        match=$(grep -m1 "^${key}=" "$OVERLAY_FILE" || true)
    fi
    if [[ -z "$match" ]]; then
        match=$(grep -m1 "^${key}=" "$ENV_FILE" || true)
    fi
    if [[ -n "$match" ]]; then
        if [[ "${STRIP_MUSTACHE:-0}" -eq 1 ]]; then
            # KEY={{ op://vault/item/field }}  ->  KEY=op://vault/item/field
            match=$(echo "$match" | sed -E 's/\{\{[[:space:]]*(.*[^[:space:]])[[:space:]]*\}\}/\1/')
        fi
        echo "$match"
    else
        # The filtered template is now the only path a secret travels to a
        # service, so a requested key with no line in $ENV_FILE (typo,
        # rename, not-yet-added op:// reference) should be visible, not a
        # silent omission. This doesn't change exit code or the normal-case
        # output -- it only adds a warning alongside it.
        echo "WARNING: $key not found in $ENV_FILE" >&2
    fi
done <<< "$wanted"
