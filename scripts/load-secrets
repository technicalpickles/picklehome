#!/usr/bin/env bash
# scripts/load-secrets: copy secrets from 1Password into Automic Vault, for varlock (.env.schema).
# Usage: scripts/load-secrets [KEY...]     (run in a terminal; 1Password and Automic Vault each ask to approve)
#        mise run load-secrets -- [KEY...]
#
# With no KEY args, loads every key below that has a real reference. The reference for each
# key is read from .env.template (lines shaped KEY={{ op://... }}), the same sed that
# scripts/service-env uses, so the template stays the single place references live.
# Keys the template doesn't carry go in EXTRA_MAP; a TODO ref is refused.
#
# Values go straight from `op read` into `av save --stdin`, so they never touch disk,
# argv, or the terminal. -n matters: --stdin saves exactly what it reads, trailing
# newline included.
#
# Env: TEMPLATE overrides the template path (tests); OP and AV override the binaries.

set -euo pipefail
cd "$(dirname "$0")/.."

TEMPLATE="${TEMPLATE:-.env.template}"
OP="${OP:-op}"
AV="${AV:-av}"

# Keys varlock reads from the vault (keep in step with .env.schema), in load order.
KEYS=(FLO_USERNAME FLO_PASSWORD SKYLIGHT_EMAIL SKYLIGHT_PASSWORD)

# Keys that aren't in .env.template yet: KEY=reference. A reference containing TODO is refused.
EXTRA_MAP=(
  "SKYLIGHT_EMAIL=TODO"
  "SKYLIGHT_PASSWORD=TODO"
)

in_keys() {
  local k
  for k in "${KEYS[@]}"; do [[ "$k" == "$1" ]] && return 0; done
  return 1
}

# Print the reference for $1, or nothing if there isn't one.
ref_for() {
  local key="$1" line entry
  line=$(grep -m1 "^${key}=" "$TEMPLATE" || true)
  if [[ -n "$line" ]]; then
    # KEY={{ op://vault/item/field }}  ->  op://vault/item/field   (same sed as service-env)
    echo "$line" | sed -E 's/\{\{[[:space:]]*(.*[^[:space:]])[[:space:]]*\}\}/\1/' | sed -E 's/^[^=]*=//'
    return
  fi
  for entry in "${EXTRA_MAP[@]}"; do
    [[ "${entry%%=*}" == "$key" ]] && { echo "${entry#*=}"; return; }
  done
}

explicit=1
if [[ $# -eq 0 ]]; then
  explicit=0
  set -- "${KEYS[@]}"
fi

# Validate everything before touching op or av, so a typo doesn't half-load.
loadable=()
for key in "$@"; do
  if ! in_keys "$key"; then
    echo "unknown key: ${key} (known: ${KEYS[*]})" >&2
    exit 1
  fi
  ref=$(ref_for "$key")
  if [[ -z "$ref" || "$ref" == *TODO* ]]; then
    if [[ "$explicit" -eq 1 ]]; then
      echo "${key}: no real 1Password reference yet (TODO in scripts/load-secrets or missing from ${TEMPLATE})" >&2
      exit 1
    fi
    echo "skipping ${key}: no real 1Password reference yet" >&2
    continue
  fi
  loadable+=("$key")
done

for key in "${loadable[@]}"; do
  echo "loading ${key}"
  "$OP" read -n "$(ref_for "$key")" | "$AV" save --stdin --project-directory=. "$key"
done
