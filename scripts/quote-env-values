#!/usr/bin/env python3
"""Wrap multiline and space-containing .env values in double quotes.

op inject outputs multiline 1Password notes as bare continuation lines;
.env format requires quoting for values that contain newlines or spaces.

Usage: scripts/quote-env-values <file>
Edits the file in place.
"""
import sys

lines = open(sys.argv[1]).readlines()
result = []
i = 0
while i < len(lines):
    line = lines[i]
    # Check if this is a KEY=value line
    if "=" in line and not line.startswith("#") and line.split("=", 1)[0].replace("_", "").isalnum():
        key, val = line.rstrip("\n").split("=", 1)
        # Collect continuation lines (not blank, not comment, not another KEY=)
        extras = []
        while i + 1 < len(lines):
            nxt = lines[i + 1]
            if nxt.strip() == "" or nxt.startswith("#"):
                break
            if "=" in nxt and nxt.split("=", 1)[0].replace("_", "").isalnum():
                break
            extras.append(nxt.rstrip("\n"))
            i += 1
        if extras:
            full = val + "\n" + "\n".join(extras)
            result.append(key + '="' + full + '"\n')
        elif " " in val:
            # Quote values with spaces so the dotenv parser can handle them
            result.append(key + '="' + val + '"\n')
        else:
            result.append(line)
    else:
        result.append(line)
    i += 1
open(sys.argv[1], "w").writelines(result)
