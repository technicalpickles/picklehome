#!/usr/bin/env bash
# scripts/skylight: run the pyskylight CLI (unofficial Skylight client) via uvx
# Usage: scripts/skylight <pyskylight args...>   (or: just skylight <args...>)
#
# Pinned to a reviewed commit so a run never picks up unreviewed upstream code.
# uvx downloads and builds it once, then reuses uv's cache on later runs.
# Bump PYSKYLIGHT_REV deliberately: review the upstream diff first.

set -euo pipefail

PYSKYLIGHT_REV="36b842905ce15a0d1e56159b096e219ac8f9ee77" # 2026-09-15

exec uvx --from "git+https://github.com/mcarmody/pyskylight@${PYSKYLIGHT_REV}" skylight "$@"
