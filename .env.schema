# Varlock schema (pilot): Moen Flo and Skylight logins come from Automic Vault.
# Nothing secret lives in this file. The rest of the env still comes from .env
# (built by `just dotenv`) and is not described here yet, see docs/varlock-av-secrets.md.
#
# One-time: `mise run setup`, then `mise run load-secrets` (copies the values from
# 1Password into Automic Vault, bound to this directory).
#
# Keep this schema tiny. Every av() item is requested on every run, and a Secret
# that isn't saved yet fails the whole load, so a key only goes here once it has
# been loaded into the vault.
#
# A plaintext .env next to this file wins over av(). After load-secrets, delete the
# FLO_* and SKYLIGHT_* lines from .env, or the vault is never the source.
#
# @plugin(@automic-vault/varlock-plugin@0.1.0)
# @disableProcessEnvInjection
# @defaultSensitive=false
# ---

# Moen Flo login (read by water/flo/auth.py).
# @required
FLO_USERNAME=av()

# @sensitive @required
FLO_PASSWORD=av()

# Auth flow: 0 is aioflo's legacy users/auth endpoint (the default), 1 opts into SSO.
FLO_USE_SSO=0

# Skylight login (used by the skylight recipes).
# @required
SKYLIGHT_EMAIL=av()

# @sensitive @required
SKYLIGHT_PASSWORD=av()
